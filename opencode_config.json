{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "llamacpp/omnicoder-9b-q8-local",
  "small_model": "llamacpp/omnicoder-9b-q8-local",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp local",
      "options": {
        "baseURL": "http://192.168.10.8:8080/v1",
        "apiKey": "no-key"
      },
      "models": {
        "gemma-4-e4b-q8-local": {
          "name": "Gemma 4 E4B Q8 Local",
          "limit": {
            "context": 65536,
            "output": 12288
          }
        },
        "omnicoder-9b-q8-local": {
                  "name": "OmniCoder 9B Q8 Local",
                  "limit": {
                    "context": 65536,
                    "output": 12288
            }
        }
      }
    }
  },
  "permission": {
      "edit": {
          "*": "deny"
      },
    "bash": "allow",
    "webfetch": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "question": "allow",
    "read": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**"
    ]
  }
}
